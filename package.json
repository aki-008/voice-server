{
  "name": "voice-server-spa",
  "version": "1.0.0",
  "description": "SPA (Vite + vanilla TS) with an Express (TypeScript) backend",
  "type": "module",
  "scripts": {
    "check": "eslint . && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.json --noEmit",
    "dev": "concurrently -k -n server,client -c cyan,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "clean": "node -e \"const fs = require('node:fs'); for (const dir of ['dist', 'dist-server']) fs.rmSync(dir, { recursive: true, force: true });\"",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ngrok/ngrok": "^1.7.0",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0"
  }
}
